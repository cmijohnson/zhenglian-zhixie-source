POSTGRES_DB=yingge_cloud
POSTGRES_USER=yingge_app
POSTGRES_PASSWORD=
POSTGRES_IMAGE=yingge/postgres-pgvector:18.4-vector0.8.6
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
YINGGE_WEBHOOK_MASTER_KEY=
FEISHU_INTEGRATION_MASTER_KEY=
FEISHU_SYNC_RUN_DELAY_MS=60000
FEISHU_WORKBENCH_BASE_URL=https://crm.example.com
# Production recommendation after the public gateway has a trusted certificate:
# https://crm.example.com/api/v1/auth/feishu/callback
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_ALLOW_INSECURE_OAUTH_PILOT=false
FEISHU_LONG_CONNECTION_ENABLED=true
FEISHU_INBOUND_RUN_DELAY_MS=5000
# Enterprise WeChat AI bot credentials must be injected by the deployment environment.
# Never commit the real Bot ID or Secret.
WECOM_AIBOT_ENABLED=false
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_ORGANIZATION_ID=
WECOM_AIBOT_PUBLIC_BASE_URL=https://crm.example.com
WECOM_AIBOT_ENDPOINT=wss://openws.work.weixin.qq.com
WECOM_AIBOT_CONNECT_INITIAL_DELAY_MS=3000
WECOM_AIBOT_HEARTBEAT_MS=30000
WECOM_AGENT_MASTER_KEY=
WECOM_AGENT_BASE_URL=http://ai.example.com/v1
WECOM_AGENT_API_KEY=
APP_RELEASE_VERSION=2026.09.28.2
HTTP_PORT=8080
POSTGRES_DATA_DIR=./.data/postgres
BACKUP_DIR=./.data/backups
MIGRATION_DIR=./.data/migration
TZ=Asia/Shanghai
